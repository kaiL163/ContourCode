    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@vitejs/plugin-react": "6.2.1",
    "codemirror": "^6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.0"
